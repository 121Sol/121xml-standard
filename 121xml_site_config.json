  "userInteraction": {
    "tracking": {
      "enabled": true,
      "location": "/var/www/121xml/data/interactions",
      "retention_days": 365,
      "fields": [
        "user_id",
        "timestamp",
        "action",
        "object_type",
        "object_id",
        "ai_engine_used",
        "model_used",
        "tokens_used",
        "compression_ratio",
        "result_address"
      ]
    },
    "analytics": {
      "enabled": true,
      "aggregationInterval": "hourly",
      "dashboardLocation": "/analytics"
    }
  },

  "userWorkspace": {
    "projects": {
      "location": "/var/www/121xml/data/user-projects",
      "defaultQuotaMB": 5000,
      "structure": {
        "name": "project_name",
        "created": "ISO8601",
        "lastModified": "ISO8601",
        "objects": "array of object IDs",
        "conversations": "array of conversation IDs",
        "metadata": "object"
      }
    },
    "conversations": {
      "location": "/var/www/121xml/data/conversations",
      "structure": {
        "id": "unique_id",
        "projectId": "parent_project",
        "messages": "array",
        "contentAddresses": "array of SHA256 hashes",
        "aiEngine": "engine_used",
        "model": "model_used",
        "createdAt": "ISO8601",
        "archivedAt": "ISO8601 or null"
      }
    },
    "memories": {
      "location": "/var/www/121xml/data/memories",
      "types": [
        "context_notes",
        "project_history",
        "preferences",
        "shortcuts",
        "knowledge_base"
      ]
    },
    "objects": {
      "location": "/var/www/121xml/data/objects",
      "indexing": true,
      "searchable": true,
      "versionControl": true
    }
  },

  "security": {
    "encryption": {
      "atRest": "AES-256",
      "inTransit": "TLS 1.3",
      "keyManagement": "environment_variables"
    },
    "authentication": {
      "method": "api_key",
      "tokenExpiration": "24hours",
      "refreshTokenExpiration": "30days"
    },
    "audit": {
      "enabled": true,
      "location": "/var/www/121xml/data/audit",
      "fields": ["user", "action", "timestamp", "resource", "result"]
    }
  },

  "dataProtection": {
    "contentAddressing": {
      "enabled": true,
      "algorithm": "SHA256",
      "immutable": true,
      "format": "data://sha256:HASH:TYPE"
    },
    "compression": {
      "enabled": true,
      "algorithm": "sparse_reference_encoding",
      "ratio": 0.94,
      "dataLoss": 0.0
    },
    "archival": {
      "enabled": true,
      "location": "/var/www/121xml/data/archive",
      "retention": "permanent",
      "recovery": "guaranteed"
    }
  },

  "api": {
    "baseUrl": "https://121xml.com/api",
    "version": "v1",
    "endpoints": {
      "convert": "/convert",
      "compress": "/compress",
      "address": "/address",
      "validate": "/validate",
      "archive": "/archive",
      "metrics": "/metrics",
      "health": "/health"
    },
    "rateLimit": {
      "requestsPerMinute": 100,
      "tokensPerDay": 1000000
    }
  },

  "notifications": {
    "enabled": true,
    "types": ["deployment", "error", "completion", "milestone"],
    "channels": ["email", "dashboard", "webhook"]
  }
}
