{
  "site": {
    "name": "121XML AI OS",
    "version": "1.0",
    "environment": "production",
    "created": "2026-08-07",
    "description": "Unified 121XML platform with multi-engine AI support and XML specification knowledge base"
  },

  "objectStore": {
    "default": {
      "location": "/var/www/121xml/data/objects",
      "format": "121xml",
      "compression": true,
      "contentAddressing": true,
      "immutable": true,
      "archiveRetention": "permanent"
    },
    "backup": {
      "enabled": true,
      "location": "/var/www/121xml/data/backups",
      "frequency": "daily",
      "retention_days": 90
    },
    "userProjects": {
      "location": "/var/www/121xml/data/user-projects",
      "maxSizeMB": 5000,
      "quota_enforcement": true
    }
  },

  "aiEngines": {
    "available": [
      {
        "id": "claude",
        "name": "Claude (Anthropic)",
        "provider": "Anthropic",
        "models": ["claude-opus-5", "claude-sonnet-5", "claude-haiku-4.5"],
        "apiEndpoint": "https://api.anthropic.com/v1",
        "requiresKey": true,
        "keyName": "ANTHROPIC_API_KEY",
        "defaultModel": "claude-opus-5",
        "costPer1kTokens": 0.015,
        "description": "Advanced reasoning, code generation, analysis",
        "recommended": true,
        "features": ["reasoning", "code", "analysis", "xml", "banking", "healthcare"]
      },
      {
        "id": "openai",
        "name": "OpenAI (GPT)",
        "provider": "OpenAI",
        "models": ["gpt-4-turbo", "gpt-4o", "gpt-3.5-turbo"],
        "apiEndpoint": "https://api.openai.com/v1",
        "requiresKey": true,
        "keyName": "OPENAI_API_KEY",
        "defaultModel": "gpt-4-turbo",
        "costPer1kTokens": 0.01,
        "description": "General purpose language model",
        "recommended": false,
        "features": ["chat", "generation", "analysis"]
      },
      {
        "id": "google",
        "name": "Google Gemini",
        "provider": "Google",
        "models": ["gemini-2.0-pro", "gemini-1.5-pro", "gemini-1.5-flash"],
        "apiEndpoint": "https://generativelanguage.googleapis.com/v1beta",
        "requiresKey": true,
        "keyName": "GOOGLE_API_KEY",
        "defaultModel": "gemini-2.0-pro",
        "costPer1kTokens": 0.0075,
        "description": "Multimodal reasoning and analysis",
        "recommended": false,
        "features": ["reasoning", "multimodal", "analysis"]
      },
      {
        "id": "together",
        "name": "Together AI",
        "provider": "Together Computer",
        "models": ["meta-llama/Llama-3-70b-chat-hf", "mistralai/Mixtral-8x7B-Instruct-v0.1"],
        "apiEndpoint": "https://api.together.xyz/v1",
        "requiresKey": true,
        "keyName": "TOGETHER_API_KEY",
        "defaultModel": "meta-llama/Llama-3-70b-chat-hf",
        "costPer1kTokens": 0.001,
        "description": "Open-source models at scale",
        "recommended": false,
        "features": ["open-source", "cost-effective", "customizable"]
      },
      {
        "id": "cohere",
        "name": "Cohere",
        "provider": "Cohere",
        "models": ["command-r-plus", "command-r", "command-light"],
        "apiEndpoint": "https://api.cohere.com/v1",
        "requiresKey": true,
        "keyName": "COHERE_API_KEY",
        "defaultModel": "command-r-plus",
        "costPer1kTokens": 0.003,
        "description": "Semantic search and generation",
        "recommended": false,
        "features": ["semantic-search", "retrieval", "generation"]
      },
      {
        "id": "mistral",
        "name": "Mistral AI",
        "provider": "Mistral",
        "models": ["mistral-large", "mistral-medium", "mistral-small"],
        "apiEndpoint": "https://api.mistral.ai/v1",
        "requiresKey": true,
        "keyName": "MISTRAL_API_KEY",
        "defaultModel": "mistral-large",
        "costPer1kTokens": 0.007,
        "description": "Fast and efficient language models",
        "recommended": false,
        "features": ["speed", "efficiency", "reasoning"]
      },
      {
        "id": "azure",
        "name": "Azure OpenAI",
        "provider": "Microsoft",
        "models": ["gpt-4-deployment", "gpt-4-turbo-deployment"],
        "apiEndpoint": "https://{resource}.openai.azure.com/",
        "requiresKey": true,
        "keyName": "AZURE_OPENAI_KEY",
        "defaultModel": "gpt-4-deployment",
        "costPer1kTokens": 0.015,
        "description": "Enterprise OpenAI models on Azure",
        "recommended": false,
        "features": ["enterprise", "azure-integration", "compliance"]
      }
    ],
    "selectedEngine": "claude",
    "fallbackEngine": "openai",
    "apiKeyManagement": {
      "storage": "environment",
      "encryption": true,
      "rotation": "90days",
      "auditLog": true
    }
  },

  "xmlSpecifications": {
    "sectors": [
