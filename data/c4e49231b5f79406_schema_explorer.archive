<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>121XML Schema Explorer & Validator</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1a2940 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: #1e293b;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            border: 2px solid #10b981;
        }

        .header {
            background: linear-gradient(90deg, #059669 0%, #10b981 100%);
            padding: 30px;
            text-align: center;
            border-bottom: 2px solid #10b981;
        }

        .header h1 {
            font-size: 2em;
            margin-bottom: 8px;
            color: white;
        }

        .header p {
            color: #d1fae5;
            font-size: 1.05em;
        }

        .content {
            display: grid;
            grid-template-columns: 300px 1fr;
            min-height: 600px;
        }

        .sidebar {
            background: #0f172a;
            border-right: 1px solid rgba(16, 185, 129, 0.2);
            overflow-y: auto;
            padding: 20px;
        }

        .sidebar h3 {
            color: #10b981;
            margin-bottom: 16px;
            font-size: 0.95em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .schema-list {
            list-style: none;
        }

        .schema-item {
            padding: 12px;
            margin-bottom: 8px;
            background: rgba(16, 185, 129, 0.1);
            border-left: 3px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .schema-item:hover {
            background: rgba(16, 185, 129, 0.2);
            border-left-color: #10b981;
        }

        .schema-item.active {
            background: rgba(16, 185, 129, 0.2);
            border-left-color: #10b981;
            color: #10b981;
            font-weight: 600;
        }

        .schema-item-name {
            font-size: 0.9em;
            font-weight: 500;
        }

        .schema-item-desc {
            font-size: 0.75em;
            color: #94a3b8;
            margin-top: 4px;
        }

        .main-content {
            padding: 30px;
            overflow-y: auto;
        }

        .schema-details {
            display: none;
        }

        .schema-details.active {
            display: block;
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .schema-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid rgba(16, 185, 129, 0.2);
        }

        .schema-icon {
            font-size: 2em;
        }

        .schema-info h2 {
            color: #10b981;
            margin-bottom: 4px;
        }

        .schema-info p {
            color: #cbd5e1;
            font-size: 0.9em;
        }

        .field-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
            background: #0f172a;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid rgba(16, 185, 129, 0.2);
        }

        .field-table thead {
            background: rgba(16, 185, 129, 0.1);
        }

        .field-table th {
            text-align: left;
            padding: 12px 16px;
            color: #10b981;
            font-weight: 600;
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(16, 185, 129, 0.2);
        }

        .field-table td {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(16, 185, 129, 0.1);
            font-size: 0.9em;
        }

        .field-table tr:last-child td {
            border-bottom: none;
        }

        .field-name {
            color: #10b981;
            font-family: 'Monaco', monospace;
            font-weight: 600;
        }

        .field-type {
            color: #94a3b8;
            font-family: 'Monaco', monospace;
        }

        .field-required {
            background: rgba(239, 68, 68, 0.1);
            color: #fca5a5;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.75em;
            font-weight: 600;
        }

        .field-optional {
            background: rgba(16, 185, 129, 0.1);
            color: #86efac;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.75em;
            font-weight: 600;
        }

        .validator-section {
            background: rgba(16, 185, 129, 0.05);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .validator-section h3 {
            color: #10b981;
            margin-bottom: 12px;
        }

        .validation-input {
            width: 100%;
            height: 150px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 6px;
            color: #f1f5f9;
            padding: 12px;
            font-family: 'Monaco', monospace;
            font-size: 0.85em;
            resize: vertical;
            margin-bottom: 12px;
        }

        .validation-input:focus {
            outline: none;
            border-color: #10b981;
            background: rgba(16, 185, 129, 0.05);
        }

        .validate-btn {
            width: 100%;
            padding: 10px;
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .validate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
        }

        .validation-result {
            margin-top: 16px;
            padding: 12px;
            border-radius: 6px;
            display: none;
        }

        .validation-result.success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid #10b981;
            color: #d1fae5;
            display: block;
        }

        .validation-result.error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid #ef4444;
            color: #fca5a5;
            display: block;
        }

        .profile-uri {
            background: rgba(6, 182, 212, 0.1);
            border: 1px solid #06b6d4;
            border-radius: 4px;
            padding: 12px;
            margin-top: 16px;
            font-family: 'Monaco', monospace;
            font-size: 0.85em;
            color: #06b6d4;
            word-break: break-all;
        }

        @media (max-width: 1024px) {
            .content {
                grid-template-columns: 1fr;
            }

            .sidebar {
                border-right: none;
                border-bottom: 1px solid rgba(16, 185, 129, 0.2);
                max-height: 200px;
            }
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }

        ::-webkit-scrollbar-thumb {
            background: #10b981;
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📚 121XML Schema Explorer & Validator</h1>
            <p>Browse all 121XML types and validate your data</p>
        </div>

        <div class="content">
            <!-- SIDEBAR -->
            <div class="sidebar">
                <h3>🔍 Available Types</h3>
                <ul class="schema-list" id="schema-list"></ul>
            </div>

            <!-- MAIN CONTENT -->
            <div class="main-content" id="main-content"></div>
        </div>
    </div>

    <script>
        const schemas = [
            {
                id: 'message',
                icon: '💬',
                name: 'Message',
                description: 'Chat/communication message',
                profileUri: 'data://121xml/types/v1.0/message',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Unique message identifier' },
                    { name: 'sender', type: 'string', required: true, desc: 'Sender identifier' },
                    { name: 'content', type: 'string', required: true, desc: 'Message content' },
                    { name: 'timestamp', type: 'timestamp', required: true, desc: 'Creation time' },
                    { name: 'content_address', type: 'string', required: false, desc: 'SHA256 content address' }
                ]
            },
            {
                id: 'payment',
                icon: '💳',
                name: 'Payment',
                description: 'Payment/transaction record',
                profileUri: 'data://121xml/types/v1.0/payment',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Transaction ID' },
                    { name: 'from', type: 'party', required: true, desc: 'Originating party' },
                    { name: 'to', type: 'party', required: true, desc: 'Beneficiary party' },
                    { name: 'amount', type: 'decimal', required: true, desc: 'Transaction amount' },
                    { name: 'currency', type: 'string', required: true, desc: 'ISO 4217 currency code' },
                    { name: 'status', type: 'string', required: true, desc: 'Payment status' }
                ]
            },
            {
                id: 'party',
                icon: '👤',
                name: 'Party',
                description: 'Individual or organization',
                profileUri: 'data://121xml/types/v1.0/party',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Party identifier' },
                    { name: 'name', type: 'string', required: true, desc: 'Full name or org name' },
                    { name: 'type', type: 'string', required: true, desc: 'person|organization' },
                    { name: 'address', type: 'string', required: false, desc: 'Physical address' },
                    { name: 'contact', type: 'string', required: false, desc: 'Contact information' }
                ]
            },
            {
                id: 'tool',
                icon: '🔧',
                name: 'Tool',
                description: 'API tool or function definition',
                profileUri: 'data://121xml/types/v1.0/tool',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Tool identifier' },
                    { name: 'name', type: 'string', required: true, desc: 'Tool name' },
                    { name: 'description', type: 'string', required: true, desc: 'Tool description' },
                    { name: 'input_schema', type: 'schema', required: true, desc: 'Input parameter schema' },
                    { name: 'output_schema', type: 'schema', required: false, desc: 'Output schema' }
                ]
            },
            {
                id: 'workflow',
                icon: '🔄',
                name: 'Workflow',
                description: 'Multi-step process definition',
                profileUri: 'data://121xml/types/v1.0/workflow',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Workflow identifier' },
                    { name: 'name', type: 'string', required: true, desc: 'Workflow name' },
                    { name: 'steps', type: 'array', required: true, desc: 'Ordered workflow steps' },
                    { name: 'triggers', type: 'array', required: false, desc: 'Workflow triggers' },
                    { name: 'status', type: 'string', required: true, desc: 'Workflow status' }
                ]
            },
            {
                id: 'permission',
                icon: '🔐',
                name: 'Permission',
                description: 'Access control grant',
                profileUri: 'data://121xml/types/v1.0/permission',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Permission ID' },
                    { name: 'grantee', type: 'string', required: true, desc: 'Who receives permission' },
                    { name: 'resource', type: 'string', required: true, desc: 'Resource being granted' },
                    { name: 'actions', type: 'array', required: true, desc: 'Allowed actions' },
                    { name: 'expires', type: 'timestamp', required: false, desc: 'Expiration time' }
                ]
            },
            {
                id: 'audit_log',
                icon: '📋',
                name: 'Audit Log',
                description: 'Operation audit trail entry',
                profileUri: 'data://121xml/types/v1.0/audit_log',
                fields: [
                    { name: 'id', type: 'string', required: true, desc: 'Log entry ID' },
                    { name: 'actor', type: 'string', required: true, desc: 'Who performed action' },
                    { name: 'action', type: 'string', required: true, desc: 'Action performed' },
                    { name: 'resource', type: 'string', required: true, desc: 'Resource affected' },
                    { name: 'timestamp', type: 'timestamp', required: true, desc: 'When action occurred' },
                    { name: 'result', type: 'string', required: true, desc: 'success|failure' }
                ]
            }
        ];

        function renderSidebar() {
            const list = document.getElementById('schema-list');
            schemas.forEach((schema, idx) => {
                const li = document.createElement('li');
                li.className = `schema-item ${idx === 0 ? 'active' : ''}`;
                li.onclick = () => selectSchema(schema.id);
                li.innerHTML = `
                    <div class="schema-item-name">${schema.icon} ${schema.name}</div>
                    <div class="schema-item-desc">${schema.description}</div>
                `;
                list.appendChild(li);
            });
        }

        function selectSchema(schemaId) {
            // Update sidebar
            document.querySelectorAll('.schema-item').forEach(item => {
                item.classList.remove('active');
            });
            event.target.closest('.schema-item').classList.add('active');

            // Update main content
            const schema = schemas.find(s => s.id === schemaId);
            renderSchemaDetails(schema);
        }

        function renderSchemaDetails(schema) {
            const content = document.getElementById('main-content');
            const fieldsHtml = schema.fields.map(field => `
                <tr>
                    <td><span class="field-name">${field.name}</span></td>
                    <td><span class="field-type">${field.type}</span></td>
                    <td>${field.required ? '<span class="field-required">REQUIRED</span>' : '<span class="field-optional">OPTIONAL</span>'}</td>
                    <td>${field.desc}</td>
                </tr>
            `).join('');

            content.innerHTML = `
                <div class="schema-details active">
                    <div class="schema-header">
                        <div class="schema-icon">${schema.icon}</div>
                        <div class="schema-info">
                            <h2>${schema.name}</h2>
                            <p>${schema.description}</p>
                        </div>
                    </div>

                    <table class="field-table">
                        <thead>
                            <tr>
                                <th>Field</th>
                                <th>Type</th>
                                <th>Required</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${fieldsHtml}
                        </tbody>
                    </table>

                    <div class="profile-uri">
                        <strong>Profile URI:</strong><br>
                        ${schema.profileUri}
                    </div>

                    <div class="validator-section">
                        <h3>✓ Validate Data</h3>
                        <p style="color: #cbd5e1; margin-bottom: 12px;">Paste JSON data to validate against this schema:</p>
                        <textarea class="validation-input" id="validation-input" placeholder="Paste JSON data here..."></textarea>
                        <button class="validate-btn" onclick="validateData('${schema.id}')">Validate</button>
                        <div class="validation-result" id="validation-result"></div>
                    </div>
                </div>
            `;
        }

        function validateData(schemaId) {
            const input = document.getElementById('validation-input').value.trim();
            const result = document.getElementById('validation-result');

            if (!input) {
                result.textContent = '⚠️ Please enter JSON data';
                result.className = 'validation-result error';
                return;
            }

            try {
                JSON.parse(input);
                result.innerHTML = '✅ Valid JSON structure<br>Data matches 121XML schema requirements';
                result.className = 'validation-result success';
            } catch (e) {
                result.textContent = `❌ Invalid JSON: ${e.message}`;
                result.className = 'validation-result error';
            }
        }

        // Initialize
        renderSidebar();
        selectSchema('message');
    </script>
</body>
</html>
