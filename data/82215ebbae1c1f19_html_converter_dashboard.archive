        }
        
        // Banking simulation
        function simulateSWIFTPayment() {
            const output = document.getElementById('paymentOutput');
            output.innerHTML = `
                <h4>SWIFT MT103 Payment Simulation</h4>
                <div class="success-box">
                    ✓ Payment initiated: $450,000 USD<br>
                    ✓ Route: Acme Bank → Deutsche Bank → West Bank GB<br>
