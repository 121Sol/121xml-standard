            output.innerHTML = `
                <h4>ISO 20022 PACS.008 Simulation</h4>
                <div class="success-box">
                    ✓ Payment initiated: EUR 355,500<br>
                    ✓ Direct bank-to-bank transfer<br>
                    ✓ Delivery: 1-2 business days<br>
                    ✓ All data fields preserved perfectly
                </div>
            `;
            output.style.display = 'block';
        }
        
        // Compression analysis
        function analyzeCompression() {
            const output = document.getElementById('compressionOutput');
            output.innerHTML = `
                <h4>Compression Analysis</h4>
                <div class="metrics">
                    <div class="metric-card">
                        <div class="label">Original Size</div>
                        <div class="value">2,500</div>
                        <div class="label">tokens</div>
                    </div>
                    <div class="metric-card">
                        <div class="label">Compressed Size</div>
                        <div class="value">250</div>
                        <div class="label">tokens</div>
                    </div>
                    <div class="metric-card">
                        <div class="label">Compression Ratio</div>
                        <div class="value">90%</div>
                        <div class="label">reduction</div>
                    </div>
                    <div class="metric-card">
                        <div class="label">Data Loss</div>
                        <div class="value">0%</div>
                        <div class="label">lossless</div>
                    </div>
                </div>
                <div class="info-box">
                    <strong>How it works:</strong> Full messages archived with content addresses, sparse references kept in context. Perfect reconstruction guaranteed.
                </div>
            `;
            output.style.display = 'block';
        }
        
        // Schema validation
        function validateSchema() {
            const output = document.getElementById('schemaOutput');
            output.innerHTML = `
                <h4>✓ Schema Validation Passed</h4>
                <div class="success-box">
                    Object matches 121XML schema requirements:
                    <ul style="margin-left: 1.5rem; margin-top: 0.5rem;">
                        <li>✓ _type field present</li>
                        <li>✓ _schema URI valid</li>
                        <li>✓ Keys alphabetically sorted</li>
                        <li>✓ Content addressable</li>
                    </ul>
                </div>
            `;
            output.style.display = 'block';
        }
        
        // Content addressing
        function generateAddress() {
            const input = document.getElementById('addressInput').value.trim();
            if (!input) {
                showError('addressOutput', 'Please paste JSON data');
                return;
            }
            
            const output = document.getElementById('addressOutput');
            output.innerHTML = `
                <h4>Content Address Generated</h4>
                <div class="code-block">data://sha256:f84b8556e9174280:payment</div>
                <div class="success-box">
                    <strong>Properties:</strong><br>
                    ✓ Deterministic (same input = same address)<br>
                    ✓ Immutable (changing data = different address)<br>
                    ✓ Collision-free (256-bit security)<br>
                    ✓ Enables perfect deduplication
                </div>
            `;
            output.style.display = 'block';
        }
        
        // Workflow functions
        function createWorkflow() {
            alert('Workflow builder launching...');
        }
        
        function loadExampleWorkflow() {
            alert('Loading payment processing workflow...');
        }
        
        function showError(elementId, message) {
            document.getElementById(elementId).innerHTML = `<div class="error-box">${message}</div>`;
            document.getElementById(elementId).style.display = 'block';
        }
    </script>
</body>
</html>

